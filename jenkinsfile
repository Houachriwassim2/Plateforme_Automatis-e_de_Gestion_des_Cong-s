pipeline {
    agent any

    environment {
        IMAGE_NAME = "gestion-conges-backend"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/Houachriwassim2/Plateforme_Automatis-e_de_Gestion_des_Cong-s.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Test Image') {
            steps {
                echo "Tests à ajouter plus tard (optionnel)"
            }
        }
    }

    post {
        success {
            echo "✅ Build Docker réussi"
        }
        failure {
            echo "❌ Échec du pipeline"
        }
    }
}
